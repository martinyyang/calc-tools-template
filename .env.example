# Copy to .env for local builds. Do not commit real values.
# Cloudflare Pages: set the same names under Settings → Environment variables.
# Omit any analytics ID to skip injecting that script (creatorpaycalc style).

# --- Site identity (swap per clone) ---
SITE_NAME=Calc Tools
SITE_TAGLINE=Free online calculators
SITE_URL=https://example.com
# apex | www — pick one canonical host before first index. See docs/LESSONS.md.
CANONICAL_HOST=apex
SITE_CONTACT_EMAIL=support@example.com

# --- Analytics (site-specific IDs only; never reuse across tool sites) ---
# Required slots when a site ships: GA4 (G-…) + Microsoft Clarity.
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
# Optional one-of (not both): Plausible OR Umami. Leave blank to skip.
PLAUSIBLE_DOMAIN=
UMAMI_WEBSITE_ID=
UMAMI_SRC=

# --- Payments (default OFF). Site is pure static without these. ---
# none | creem | paddle | stripe
# Legacy (deprecated): lemonsqueezy
# Default none: no checkout routes, checkout button hidden, no keys needed.
# When enabling payments, recommended value: creem (one-time only).
PAYMENT_PROVIDER=none

# Deprecated: ENABLE_STRIPE=true with no PAYMENT_PROVIDER maps to stripe.
ENABLE_STRIPE=false

# Creem (recommended). Suits mainland-China individuals; payout to Alipay.
# Hosted checkout URL, if set, is used as-is. Otherwise the Function creates
# a checkout via the API (CREEM_API_KEY + CREEM_PRODUCT_ID).
# Placeholders only — no real secrets in git.
CREEM_CHECKOUT_URL=
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=

# Paddle Billing (alternative). Payout via Payoneer.
# PADDLE_ENV: sandbox | production. One-time PADDLE_PRICE_ID only.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Stripe — only when there is an overseas company.
# payment_link | checkout_session
STRIPE_CHECKOUT_MODE=payment_link
STRIPE_PAYMENT_LINK_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Lemon Squeezy (deprecated legacy). Still works if PAYMENT_PROVIDER=lemonsqueezy.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CHECKOUT_URL=

# checkout_start + purchase events stay off until you opt in.
ENABLE_CHECKOUT_EVENTS=false

# Auth / credits — stub only. Enable when next paid tool ships.
ENABLE_AUTH_CREDITS=false
